---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";
import { Image } from "astro:assets";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;

const { Content } = await render(post);

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
};

/* ========== Prev/Next Posts ========== */

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const prevPost = currentPostIndex !== 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex < allPosts.length - 1
    ? allPosts[currentPostIndex + 1]
    : null;
---

<Layout {...layoutProps}>
  <Header />
  <main id="main-content" class="app-layout" data-pagefind-body>
    <header class="post-head">
      <div class="ui-label">{tags.slice(0, 3).join(" · ")}</div>
      <h1 transition:name={slugifyStr(title.replaceAll(".", "-"))} class="post-title">
        {title}
      </h1>
      <p class="post-dek">{description}</p>
      <div class="post-byline">
        {author} ·{" "}
        <time datetime={pubDatetime.toISOString()}>
          {pubDatetime.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })}
        </time>
      </div>
    </header>

    {
      typeof initOgImage === "object" && initOgImage && (
        <div class="art-frame post-cover">
          <Image src={initOgImage} alt="" widths={[800, 1200, 1600]} sizes="(max-width: 1160px) 100vw, 1080px" />
        </div>
      )
    }

    <div class="post-grid">
      <nav class="post-toc" id="post-toc" aria-label="Contents" data-pagefind-ignore>
        <span class="ui-label">Contents</span>
      </nav>
      <div class="post-article">
        <article id="article" class="app-prose">
          <Content />
        </article>

        <ul class="tag-list">
          {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
        </ul>

        <nav data-pagefind-ignore class="post-nav" aria-label="Adjacent posts">
          {
            prevPost && (
              <a href={getPath(prevPost.id, prevPost.filePath)} data-cursor="read">
                <span class="ui-label">Previous</span>
                {prevPost.title}
              </a>
            )
          }
          {
            nextPost && (
              <a href={getPath(nextPost.id, nextPost.filePath)} data-cursor="read">
                <span class="ui-label">Next</span>
                {nextPost.title}
              </a>
            )
          }
        </nav>
      </div>
      <div class="post-margin"></div>
    </div>
  </main>
  <Footer />
</Layout>

<script is:inline data-astro-rerun>
  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    document.getElementById("myBar")?.remove();
    const progressBar = document.createElement("div");
    progressBar.className = "reading-progress";
    progressBar.id = "myBar";
    document.body.appendChild(progressBar);
  }
  createProgressBar();

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("#article h2, #article h3, #article h4, #article h5, #article h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Contents rail: h2/h3 of the article, active one marked while reading */
  function buildToc() {
    const toc = document.getElementById("post-toc");
    if (!toc) return;
    const heads = Array.from(document.querySelectorAll("#article h2[id], #article h3[id]"))
      .filter(h => h.textContent?.trim().replace(/#$/, "") !== "Table of contents");
    if (!heads.length) { toc.style.visibility = "hidden"; return; }
    const links = new Map();
    for (const h of heads) {
      const a = document.createElement("a");
      a.href = "#" + h.id;
      a.textContent = (h.textContent ?? "").replace(/#$/, "").trim();
      if (h.tagName === "H3") a.className = "is-sub";
      toc.appendChild(a);
      links.set(h, a);
    }
    const io = new IntersectionObserver(entries => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        toc.querySelector(".is-active")?.classList.remove("is-active");
        links.get(e.target)?.classList.add("is-active");
      }
    }, { rootMargin: "0px 0px -70% 0px" });
    heads.forEach(h => io.observe(h));
  }
  buildToc();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      // Check if --file-name-offset custom property exists
      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      // Determine the top positioning class
      const topClass = hasFileNameOffset ? "top-(--file-name-offset)" : "top-2";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded border border-border bg-background px-2 py-1 text-xs leading-4 text-foreground`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>
