---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import { sectionLabel } from "@/utils/notebookPostFilter";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, tags, ...props } = data;
---

<li class="post-list-item">
  <span class="post-kind">{sectionLabel(tags)}</span>
  <a href={getPath(id, filePath)} class="post-list-title" data-cursor="read">
    <Heading style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}>
      {title}
    </Heading>
    <p class="post-list-desc">{description}</p>
    <Datetime {...props} />
  </a>
</li>
