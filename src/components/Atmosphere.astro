---
// Full-page atmosphere behind every page: pearl and lavender light refracting
// through an unseen translucent material, with a separate film-grain layer.
// The shader renders at low resolution (the field is diffuse); grain is CSS at
// native resolution so it stays sharp. Without WebGL the CSS base stays.
---

<div class="atmos" aria-hidden="true" transition:persist="atmos"><canvas data-atmos></canvas></div>
<div class="atmos-grain" aria-hidden="true" transition:persist="atmos-grain"></div>

<script>
  const FRAG = `
precision mediump float;
uniform vec2 R; uniform float T;
float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
float n(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);
  return mix(mix(h(i),h(i+vec2(1,0)),f.x),mix(h(i+vec2(0,1)),h(i+vec2(1,1)),f.x),f.y);}
float fbm(vec2 p){float v=0.,a=.5;mat2 m=mat2(1.6,1.2,-1.2,1.6);
  for(int i=0;i<5;i++){v+=a*n(p);p=m*p;a*=.5;}return v;}
float t;
// Refraction field: soft caustic-like sheets from a domain-warped fbm.
float sheet(vec2 p){
  vec2 q=vec2(fbm(p+vec2(0.,t)),fbm(p+vec2(5.2,1.3)-t*.7));
  float f=fbm(p+2.6*q);
  return pow(1.-abs(sin(f*4.4+q.x*2.6)),3.2);
}
void main(){
  t=T*.018;
  vec2 uv=gl_FragCoord.xy/R;
  vec2 p=(gl_FragCoord.xy-.5*R)/min(R.x,R.y)*1.;
  // Colour fringing: each channel reads the field slightly offset.
  vec2 o=vec2(.009,.004);
  vec3 band=vec3(sheet(p-o),sheet(p),sheet(p+o));
  float w=fbm(p*.6+t*.5);
  // Base: pearl -> silver -> pale lavender, drifting slowly.
  vec3 pearl=vec3(.955,.952,.948),silver=vec3(.905,.91,.925),lav=vec3(.925,.905,.965);
  vec3 col=mix(pearl,silver,smoothstep(.3,.75,w));
  col=mix(col,lav,smoothstep(.45,.9,fbm(p*.9-t*.3+3.)) *.8);
  // Thin-film iridescence embedded in the refraction sheets.
  float ph=w*2.4+p.x*.35+p.y*.2;
  vec3 film=.5+.5*cos(6.2831*(ph+vec3(.0,.18,.36)));
  vec3 tint=mix(vec3(.64,.58,.96),vec3(.6,.84,.97),film.y);   // violet -> glacial/cyan
  tint=mix(tint,vec3(.98,.82,.68),smoothstep(.82,1.,film.z)*.5); // occasional warmth
  col=mix(col,col*tint*1.1,band*.62);
  // Bloom: light gathers where sheets are strongest.
  col+=vec3(1.,.99,.98)*pow(band.g,2.5)*.13;
  // Midnight-indigo undertone, low and diffuse, never a dark section.
  float deep=smoothstep(.55,.95,fbm(p*.5+vec2(7.,2.)-t*.2))*smoothstep(.85,.0,uv.y+uv.x*.3);
  col=mix(col,vec3(.17,.16,.33),deep*.16);
  // Quiet lift where the text sits, and a slow breathing exposure.
  col+=.035*smoothstep(.55,0.,length((uv-.5)*vec2(1.4,1.)));
  col*=.985+.03*n(vec2(T*.05,1.7));
  gl_FragColor=vec4(clamp(col,0.,1.),1.);
}`;

  function start(canvas: HTMLCanvasElement) {
    if (canvas.dataset.running) return;
    const gl = canvas.getContext("webgl", { antialias: false, alpha: false });
    if (!gl) return;
    const sh = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, "attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}"));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
    const uR = gl.getUniformLocation(prog, "R");
    const uT = gl.getUniformLocation(prog, "T");
    canvas.dataset.running = "1";

    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    // ponytail: 0.35x resolution is enough for a diffuse field; grain is a separate full-res layer.
    const SCALE = 0.35;
    const t0 = performance.now() - 120000;
    let last = 0;

    const frame = (now: number) => {
      if (!canvas.isConnected) return;
      const w = Math.max(1, Math.round(innerWidth * SCALE));
      const h = Math.max(1, Math.round(innerHeight * SCALE));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        gl.viewport(0, 0, w, h);
        last = 0;
      }
      // The field moves slowly; 20 fps is plenty.
      if (!document.hidden && now - last > 50) {
        last = now;
        gl.uniform2f(uR, w, h);
        gl.uniform1f(uT, (still ? 120000 : now - t0) / 1000);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      }
      if (!still) requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
    if (still) addEventListener("resize", () => requestAnimationFrame(frame));
  }

  document.addEventListener("astro:page-load", () =>
    document.querySelectorAll<HTMLCanvasElement>("canvas[data-atmos]").forEach(start)
  );
</script>
