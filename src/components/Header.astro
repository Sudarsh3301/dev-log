---
import { SITE } from "@/config";

const { pathname } = Astro.url;
const first = pathname.split("/").filter(Boolean)[0];

const navItems = [
  ["Blog", "/blog"],
  ["Notes", "/notes"],
  ["Lab", "/lab"],
  ["Projects", "/projects"],
  ["Papers", "/papers"],
  ["Random", "/random"],
  ["About", "/about"],
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent transition-all focus:top-4"
>
  Skip to content
</a>

<div class="site-header-wrap">
  <header class="site-header app-layout">
    <a href="/" class="site-title">{SITE.title}</a>
    <nav class="site-nav" aria-label="Primary navigation">
      {
        navItems.map(([label, href]) => (
          <a href={href} aria-current={first === href.slice(1) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
  </header>
</div>
