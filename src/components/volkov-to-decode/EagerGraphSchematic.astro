<style>
.vf { margin: 1.75rem auto; }
.vf svg { width: 100%; height: auto; display: block; font-family: var(--font-mono); }
.vf .src { font-family: var(--font-mono); font-size: 0.68rem; color: var(--muted-text); margin-top: 0.35rem; text-align: left; }
.vf .tog { font-family: var(--font-mono); font-size: 0.75rem; display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.4rem; }
.vf .tog label { border: 1px dashed var(--border); padding: 0.15rem 0.5rem; cursor: pointer; color: var(--muted-text); }
.vf .tog input { position: absolute; opacity: 0; pointer-events: none; }
.vf .tog input:checked + span { color: var(--accent); }
.vf .tog label:has(input:checked) { border-style: solid; border-color: var(--accent); }
.vf .tog label:has(input:focus-visible) { outline: 2px solid var(--accent); }
.vf .opt { opacity: 0; transition: opacity 0.2s; }
.vf:has(input[value=a]:checked) .opt-a, .vf:has(input[value=b]:checked) .opt-b, .vf:has(input[value=c]:checked) .opt-c { opacity: 1; }
</style>
