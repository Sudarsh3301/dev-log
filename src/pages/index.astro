---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconBrandX from "@/assets/icons/IconBrandX.svg";
import IconLinkedin from "@/assets/icons/IconLinkedin.svg";
import IconMail from "@/assets/icons/IconMail.svg";
import IconGraduationCap from "@/assets/icons/IconGraduationCap.svg";

const sections = ["Blog", "Notes", "Lab", "Projects", "Papers", "Random"];

const socials = [
  { href: SITE.github, label: "GitHub", Icon: IconGitHub },
  { href: SITE.twitter, label: "X", Icon: IconBrandX },
  { href: SITE.linkedin, label: "LinkedIn", Icon: IconLinkedin },
  { href: SITE.email, label: "Email", Icon: IconMail },
  { href: SITE.googleScholar, label: "Google Scholar", Icon: IconGraduationCap },
].filter(s => s.href);
---

<Layout title={SITE.title} description={SITE.desc}>
  <Header />
  <main id="main-content" data-layout="index" class="home">
    <h1 class="home-name">{SITE.author}</h1>
    <p class="home-bio">
      I work on reasoning systems, inference optimization, and multimodal AI.
      My <a href="/random/blogs/motives">world model</a> is simple: build systems
      that expose how models think, not just what they output.
    </p>
    <nav class="home-sections" aria-label="Notebook sections">
      {sections.map(label => <a href={`/${label.toLowerCase()}`}>{label}</a>)}
    </nav>
    <div class="home-icons">
      {socials.map(({ href, label, Icon }) => (
        <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`${SITE.author} on ${label}`}>
          <Icon />
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    if (document.querySelector("#main-content[data-layout='index']")) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
