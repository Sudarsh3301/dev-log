---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SectionPostList from "@/components/SectionPostList.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { hasNotebookTag, hasSectionTag } from "@/utils/notebookPostFilter";
import { SITE } from "@/config";

// The default feed excludes anything claimed by a more specific section
// (Random/Papers/Lab/Notes/Projects) so a post lands in exactly one place.
const posts = await getCollection(
  "blog",
  ({ data }) => hasNotebookTag(data.tags) && !hasSectionTag(data.tags)
);
---

<Layout
  title={`Blog | ${SITE.title}`}
  description="Long-form technical writing."
>
  <Header />
  <Main pageTitle="Blog" pageDesc="Long-form technical writing.">
    <SectionPostList
      posts={getSortedPosts(posts)}
      emptyText="Long-form research notes will collect here."
    />
  </Main>
  <Footer />
</Layout>
